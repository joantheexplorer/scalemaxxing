# Test 01: Declarations and Units
dim distance = 100 [m]
dim duration = 12.2 [s]
dim velocity = 25.0 [m/s]

# Multiple variable declarations on a single line separated by commas
dim width = 10.0 [m], height = 5.0 [m], mass = 45.0 [kg]
pure multiplier = 1.5, scaleFactor = 2.0, limit = 100

# Custom unit definition
unit Force = kg * m / (s * s);
unit Velocity = m / s;
unit Acceleration = m / s^2;
unit Pressure = kg / (m * s^2);

# Pure scalar variable declarations without physical units
pure PI = 3.14159265;
pure offset = 0.5;
pure leadingDot = .5;
pure zeroIndex = 0;

# Scientific notation literals with dimensional units
dim wavelength = 1.5e-6 [m]
pure speedOfLight = 3e8 [m/s]
pure planckConstant = 6.626e-34
dim microMass = 1.5e-6 [kg]
pure largeScale = 1.25E+5
